{
  "compilerOptions": {
    "lib": ["ESNext"],
    "target": "ESNext",
    "module": "Preserve",
    "moduleDetection": "force",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,

    "jsx": "react-jsx",
    "jsxImportSource": "@opentui/react",

    "types": ["bun"],

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true
  },
  "include": ["src", "shared", "server", "test"],
  // The Worker compiles against Cloudflare's runtime types, which clash with Bun's.
  "exclude": ["server/cloudflare"]
}
